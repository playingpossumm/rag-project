.venv/
__pycache__/
*.pyc
.env
*.index
vector_store/

# scratch dirs from UI verification runs
.tmp-*/

# Node tooling for the architecture map only
node_modules/

# Topic corpora, rebuildable with src/fetch_topic.py -- not worth 100MB in git
data-quant/
data-birds/

# Passage text dumped for the answer-highlight sweep. Regenerable with
# src/dump_top_passages.py, and it is 900KB of verbatim text from the two
# corpora above -- keeping it here would put in git exactly what those lines
# keep out. ui/test-answer-mark.mjs skips its sweep when this is absent.
eval/top-passages.json

# Third-party source documents and everything derived from them: 36 arXiv PDFs
# and two vector stores holding the same text again, verbatim, in metadata.json.
# Untracked from 2026-08-28 so they are not in HEAD.
#
# They are not in the history either, since 2026-09-07. They were, deliberately,
# for ten days, on the argument that a rewrite would dangle the 15 commit SHAs
# this repository cites in its own prose. The rewrite ran before the repository
# went public, and the 15 SHAs were translated through the map it wrote, so
# nothing dangles. The reasoning both ways is in docs/engineering-log.md under
# 2026-08-28 and 2026-09-07, and ATTRIBUTION.md states the position.
#
# All of it is rebuildable and the README says how:
#   python src/fetch_corpus.py                      -> data/
#   python src/fetch_topic.py --topic birds ...     -> data-birds/
#   python src/ingest.py                            -> the store
data/
store-birds/
store-quant/

# The published artifacts' URLs and the account that owns them. HANDOFF
# section 8 keeps the reasoning, which is public; the addresses are not.
docs/artifacts.local.md

# Recorded traces for a static deployment. Regenerated by src/record_static.py
# from the corpus and the index, so it is derived rather than source -- and for
# the arXiv corpora it would be passage text again, which is the thing that is
# deliberately not published here.
static-demo/
.vercel
