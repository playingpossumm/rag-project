{
  "name": "rag-project-architecture",
  "private": true,
  "type": "module",
  "description": "Build tooling for the isometric architecture map only. The project itself is Python; this exists because the map ships as a bundled standalone page.",
  "scripts": {
    "architecture:sync": "node scripts/architecture-sync.mjs && node scripts/architecture-history.mjs",
    "architecture:check": "node scripts/architecture-sync.mjs --check",
    "architecture:build": "npm run architecture:sync && node scripts/build-architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.24.0",
    "react": "19.2",
    "react-dom": "19.2",
    "typescript": "^5.6.3"
  }
}
